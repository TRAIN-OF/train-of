{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TRAIN-OF/train-of/schemas/train-route.schema.json",
  "title": "TRAIN-OF route",
  "type": "object",
  "required": ["schema", "line_id", "cadence", "stations"],
  "properties": {
    "schema": {
      "const": "train-of.route.v0"
    },
    "line_id": {
      "type": "string"
    },
    "conductor": {
      "type": "string",
      "description": "Optional conductor identity path for conductor-driven lines."
    },
    "conductor_haecceity": {
      "type": "object",
      "description": "Runtime identity envelope for the conductor. Stable identity and per-instance lifecycle evidence are deliberately separate.",
      "required": ["stable_identity"],
      "properties": {
        "stable_identity": {
          "type": "string",
          "description": "Stable card/deck/role identity; does not change at compaction."
        },
        "instance_number": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "One-indexed context-window instance observed by the harness. Historical on a receipt; null when unavailable."
        },
        "compaction_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Canonical compaction boundary count supporting instance_number."
        },
        "session_id": {
          "type": ["string", "null"],
          "description": "Optional local session grouping key; omit from public routes when privacy requires it."
        },
        "observed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "provenance": {
          "type": "string",
          "description": "Evidence source, such as instance-identification SessionStart hook."
        }
      },
      "additionalProperties": false
    },
    "cadence": {
      "type": "object",
      "required": ["interval_minutes"],
      "properties": {
        "interval_minutes": { "type": "number", "exclusiveMinimum": 0 },
        "cycle_minutes": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "arrival_policy": {
      "enum": ["thin-event", "thin-event-with-cargo-key", "station-signage"]
    },
    "station_service": {
      "type": "object",
      "description": "Mandatory work-service contract applied at every station on every cycle.",
      "required": ["visit_every_station", "claim_policy", "allowed_outcomes"],
      "properties": {
        "visit_every_station": { "const": true },
        "claim_policy": {
          "enum": ["claim-unassigned-authorized-work", "scan-and-claim"]
        },
        "work_lanes": {
          "const": ["old-backlog", "new-offer"]
        },
        "authority_scan_required": { "type": "boolean" },
        "allowed_outcomes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "no_fake_station_substitution": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "identity_routing": {
      "type": "object",
      "description": "Priority and failover rules for real principals versus sidecars.",
      "required": ["principal_priority", "sidecar_impersonation", "unreachable_threshold_visits"],
      "properties": {
        "principal_priority": { "const": "real-deck-identity-first" },
        "sidecar_impersonation": { "const": false },
        "unreachable_threshold_visits": { "type": "integer", "minimum": 1 },
        "fallback_control_mode": { "const": "station-controlled" }
      },
      "additionalProperties": false
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["station_id", "role"],
        "properties": {
          "station_id": { "type": "string" },
          "role": { "type": "string" },
          "thread_id": { "type": ["string", "null"] },
          "fallback_thread_id": { "type": ["string", "null"] },
          "principal_identity": { "type": ["string", "null"] },
          "sidecar_identity": { "type": ["string", "null"] },
          "control_mode": {
            "enum": ["principal-first", "station-controlled", "sidecar-observer"]
          },
          "unique_domain": { "type": "string" },
          "authority": { "type": "string" },
          "backlog_source": { "type": "string" },
          "service_actions": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
