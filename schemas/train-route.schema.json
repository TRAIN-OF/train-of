{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TRAIN-OF/train-of/schemas/train-route.schema.json",
  "title": "TRAIN-OF route protocol v2",
  "type": "object",
  "required": ["schema", "protocol_version", "line_id", "cadence", "stations"],
  "properties": {
    "schema": {
      "const": "train-of.route.v2"
    },
    "protocol_version": {
      "const": "2.0.0",
      "description": "SemVer version of the route protocol; v2 requires verified remote addressing for every registered station."
    },
    "line_id": {
      "type": "string"
    },
    "conductor": {
      "type": "string",
      "description": "Optional conductor identity path for conductor-driven lines."
    },
    "cadence": {
      "type": "object",
      "required": ["interval_minutes"],
      "properties": {
        "interval_minutes": { "type": "number", "exclusiveMinimum": 0 },
        "cycle_minutes": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "arrival_policy": {
      "enum": ["thin-event", "thin-event-with-cargo-key", "station-signage"]
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["station_id", "role", "address"],
        "properties": {
          "station_id": { "type": "string" },
          "role": { "type": "string" },
          "thread_id": { "type": ["string", "null"] },
          "fallback_thread_id": { "type": ["string", "null"] },
          "address": {
            "type": "object",
            "required": ["host_id", "thread_id", "machine", "account", "cwd", "reply_to", "verified_at", "transport_evidence"],
            "properties": {
              "host_id": { "type": "string", "minLength": 1 },
              "thread_id": { "type": "string", "minLength": 1 },
              "machine": { "type": "string", "minLength": 1 },
              "account": { "type": "string", "minLength": 1 },
              "cwd": { "type": "string", "minLength": 1 },
              "reply_to": { "type": "string", "minLength": 1 },
              "verified_at": { "type": "string", "format": "date-time" },
              "transport_evidence": {
                "type": "object",
                "required": ["nonce", "acknowledged_at"],
                "properties": {
                  "nonce": { "type": "string", "minLength": 1 },
                  "acknowledged_at": { "type": "string", "format": "date-time" }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
