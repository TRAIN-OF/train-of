{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TRAIN-OF/train-of/schemas/train-route.schema.json",
  "title": "TRAIN-OF route protocol v2.1",
  "type": "object",
  "required": ["schema", "protocol_version", "line_id", "cadence", "stations"],
  "properties": {
    "schema": {
      "const": "train-of.route.v2"
    },
    "protocol_version": {
      "enum": ["2.0.0", "2.1.0"],
      "description": "SemVer version of the route protocol; v2 requires verified remote addressing for every registered station. Version 2.1.0 adds optional conditional event arrivals."
    },
    "line_id": {
      "type": "string"
    },
    "conductor": {
      "type": "string",
      "description": "Optional conductor identity path for conductor-driven lines."
    },
    "line_class": {
      "type": "object",
      "description": "Optional route-quality declaration; class metadata does not replace concrete route state.",
      "required": ["id", "color", "loop_shape", "station_depth_policy"],
      "properties": {
        "id": { "enum": ["express", "deep-survey"] },
        "color": { "enum": ["🟧", "🟦"] },
        "loop_shape": { "enum": ["ordered-pass", "hub-and-return"] },
        "station_depth_policy": { "enum": ["bounded-health", "vary-by-risk"] },
        "foreign_repo_keys": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "cadence": {
      "type": "object",
      "required": ["interval_minutes"],
      "properties": {
        "interval_minutes": { "type": "number", "exclusiveMinimum": 0 },
        "cycle_minutes": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "arrival_policy": {
      "enum": ["thin-event", "thin-event-with-cargo-key", "station-signage"]
    },
    "event_arrivals": {
      "type": "object",
      "description": "Optional v2.1.0 conditional-event adapter declaration. Conditional arrivals must not advance the route cursor.",
      "required": ["enabled", "dedupe_key", "rehydrate_authority"],
      "properties": {
        "enabled": { "type": "boolean" },
        "dedupe_key": { "const": "event_id+target_session_id" },
        "rehydrate_authority": { "const": "github" },
        "adapter": { "type": "string" }
      },
      "additionalProperties": true
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["station_id", "role", "address"],
        "properties": {
          "station_id": { "type": "string" },
          "role": { "type": "string" },
          "inspection_depth": { "enum": ["express", "deep"] },
          "instruction": { "type": "string" },
          "thread_id": { "type": ["string", "null"] },
          "fallback_thread_id": { "type": ["string", "null"] },
          "address": {
            "type": "object",
            "required": ["host_id", "thread_id", "machine", "account", "cwd", "reply_to", "verified_at", "transport_evidence"],
            "properties": {
              "host_id": { "type": "string", "minLength": 1 },
              "thread_id": { "type": "string", "minLength": 1 },
              "machine": { "type": "string", "minLength": 1 },
              "account": { "type": "string", "minLength": 1 },
              "cwd": { "type": "string", "minLength": 1 },
              "reply_to": { "type": "string", "minLength": 1 },
              "verified_at": { "type": "string", "format": "date-time" },
              "transport_evidence": {
                "type": "object",
                "required": ["nonce", "acknowledged_at"],
                "properties": {
                  "nonce": { "type": "string", "minLength": 1 },
                  "acknowledged_at": { "type": "string", "format": "date-time" }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
